module ardupilot_msgs { module msg { struct ControlSurfaceOutput {
  unsigned long long time_us;
  unsigned long long clock_us;
  unsigned long sequence_id;
  unsigned long configuration_revision;
  unsigned long clipping_flags;
  octet state;
  octet reason;
  octet mode;
  octet count;
  boolean accepted;
  float mixing_gain;
  float mixing_offset;
  float airspeed;
  float requested[3];
  float applied[3];
  float attitude[3];
  float rates[3];
  short function[32];
  unsigned short minimum[32];
  unsigned short trim[32];
  unsigned short maximum[32];
  octet reversed[32];
  float excitation[32];
  unsigned short baseline[32];
  unsigned short pwm[32];
  short delta[32];
  octet clipped[32];
}; }; };
